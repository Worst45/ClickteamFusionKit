<Project Sdk="Microsoft.NET.Sdk">

  <!-- Test bench: raw rendering of the events by Nebula (without MfaDump's formatting).
       Default: the kit's fork (external\NebulaFD). To compare with another version of
       Nebula: dotnet build -p:NebulaDir=<folder containing Nebula.Core> -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <NoWarn>NU1702;CS8632</NoWarn>
    <NebulaDir Condition="'$(NebulaDir)' == ''">..\..\external\NebulaFD</NebulaDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(NebulaDir)\Nebula.Core\Nebula.Core.csproj" />
  </ItemGroup>

</Project>
